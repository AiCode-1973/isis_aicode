#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * ÍSIS - comandos de linha de comando.
 *
 * Instalação e atualização
 *   php bin/isis key:generate      Gera APP_KEY no .env (somente se estiver vazia)
 *   php bin/isis migrate           Aplica migrations pendentes e atualiza os catálogos globais
 *   php bin/isis install [--demo]  migrate + bloqueio do instalador web (+ dados fictícios)
 *   php bin/isis seed:demo         Cria as empresas fictícias e completa os dados demonstrativos dos módulos
 *
 * Rotina (agendar no cron / Agendador de Tarefas)
 *   php bin/isis diario            backup + rotação + lembretes + manutenção (uma vez por dia)
 *   php bin/isis backup [--sem-arquivos]   Cópia criptografada do banco e das evidências em storage/backups
 *   php bin/isis lembretes         Envia o resumo diário de pendências por e-mail
 *   php bin/isis manutencao        Limpa registros temporários vencidos
 *
 * Suporte
 *   php bin/isis verificar         Verifica requisitos, banco, migrations, auditoria, backup e e-mail
 *   php bin/isis email:teste <destino@exemplo.com>   Envia um e-mail de teste com a configuração atual
 *   php bin/isis audit:verify      Verifica a cadeia de hashes da auditoria de todas as empresas
 *   php bin/isis backup:listar
 *   php bin/isis backup:decifrar <arquivo.isisbak> <saida.zip>
 *   php bin/isis backup:restaurar <arquivo.isisbak> [--banco=nome] [--force] [--sem-arquivos]
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require dirname(__DIR__) . '/app/bootstrap.php';
require APP_ROOT . '/database/seeds/DemoSeeder.php';

use Isis\Audit\AuditHasher;
use Isis\Core\Config;
use Isis\Core\Crypto;
use Isis\Core\Database;
use Isis\Database\Seeds\DemoSeeder;
use Isis\Services\BackupService;
use Isis\Services\Installer;
use Isis\Services\MaintenanceService;
use Isis\Services\ReminderService;

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);
$options = [];
$positional = [];
foreach ($args as $arg) {
    if (str_starts_with($arg, '--')) {
        [$name, $value] = array_pad(explode('=', substr($arg, 2), 2), 2, true);
        $options[$name] = $value;
    } else {
        $positional[] = $arg;
    }
}

function out(string $text = ''): void
{
    fwrite(STDOUT, $text . PHP_EOL);
}

function demo(): void
{
    out('Dados demonstrativos (senha de todos: ' . DemoSeeder::PASSWORD . '):');
    foreach (DemoSeeder::run() as $line) {
        out('  ' . $line);
    }
}

function backup(bool $withFiles): void
{
    $result = BackupService::create($withFiles);
    out(sprintf('Backup criado: %s (%s) · %d tabelas, %d registros, %d arquivo(s) de evidência.',
        basename($result['file']), fmt_bytes($result['size']), $result['tables'], $result['rows'], $result['files']));
    $removed = BackupService::rotate((int) Config::get('backup.keep_daily', 7), (int) Config::get('backup.keep_weekly', 4));
    if ($removed !== []) {
        out('Backups antigos removidos: ' . implode(', ', $removed));
    }
}

try {
    switch ($command) {
        case 'key:generate':
            $envFile = APP_ROOT . '/.env';
            if (!is_file($envFile)) {
                copy(APP_ROOT . '/.env.example', $envFile);
                out('.env criado a partir de .env.example');
            }
            $env = (string) file_get_contents($envFile);
            if (preg_match('/^APP_KEY=base64:\S+/m', $env)) {
                out('APP_KEY já existe. Não foi alterada (trocar a chave tornaria ilegíveis os dados criptografados e os backups).');
                break;
            }
            $key = Crypto::generateKey();
            $env = preg_match('/^APP_KEY=.*$/m', $env)
                ? (string) preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $env)
                : $env . PHP_EOL . 'APP_KEY=' . $key . PHP_EOL;
            file_put_contents($envFile, $env);
            out('APP_KEY gerada e gravada no .env. Guarde uma cópia segura dela fora do servidor.');
            break;

        case 'migrate':
            $ran = Installer::migrate();
            out($ran ? 'Migrations aplicadas: ' . implode(', ', $ran) : 'Banco já está atualizado.');
            out(Installer::seedCatalogs());
            break;

        case 'install':
            foreach (Installer::requirements() as $label => $check) {
                out(sprintf('[%s] %s (%s)', $check['ok'] ? 'ok' : '!!', $label, $check['detail']));
            }
            $ran = Installer::migrate();
            out($ran ? 'Migrations aplicadas: ' . implode(', ', $ran) : 'Banco já está atualizado.');
            out(Installer::seedCatalogs());
            if (isset($options['demo'])) {
                demo();
            }
            Installer::lock();
            out('Instalação concluída. Instalador web bloqueado (storage/install.lock).');
            break;

        case 'seed:demo':
            demo();
            break;

        case 'backup':
            backup(!isset($options['sem-arquivos']));
            break;

        case 'backup:listar':
            $items = BackupService::list();
            out($items ? '' : 'Nenhum backup em storage/backups.');
            foreach ($items as $item) {
                out(sprintf('  %s  %s  %s', $item['name'], str_pad(fmt_bytes($item['size']), 9, ' ', STR_PAD_LEFT), $item['date']));
            }
            break;

        case 'backup:decifrar':
            if (count($positional) < 2) {
                throw new RuntimeException('Uso: php bin/isis backup:decifrar <arquivo.isisbak> <saida.zip>');
            }
            $manifest = BackupService::decryptTo($positional[0], $positional[1]);
            out('Backup decifrado em ' . $positional[1] . ' · gerado em ' . ($manifest['created_at'] ?? '?') . ', versão ' . ($manifest['version'] ?? '?') . '.');
            out('ATENÇÃO: o ZIP contém dados pessoais em claro. Apague-o depois de usar.');
            break;

        case 'backup:restaurar':
            if (count($positional) < 1) {
                throw new RuntimeException('Uso: php bin/isis backup:restaurar <arquivo.isisbak> [--banco=nome] [--force] [--sem-arquivos]');
            }
            $dbName = is_string($options['banco'] ?? null) ? $options['banco'] : (string) Config::get('db.database');
            Database::assertIdentifier(strtolower(str_replace('-', '_', $dbName)));
            $pdo = new PDO(
                sprintf('mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4', Config::get('db.host'), Config::get('db.port'), $dbName),
                (string) Config::get('db.username'), (string) Config::get('db.password'),
                [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
            );
            $result = BackupService::restore($positional[0], $pdo, isset($options['force']), !isset($options['sem-arquivos']));
            out(sprintf('Restauração concluída no banco %s: %d comandos executados, %d arquivo(s) de evidência restaurado(s).', $dbName, $result['statements'], $result['files']));
            break;

        case 'lembretes':
            $stats = ReminderService::run();
            out(sprintf('Lembretes: %d e-mail(s) enviado(s) em %d empresa(s); %d já enviado(s) hoje.', $stats['sent'], $stats['tenants'], $stats['skipped']));
            break;

        case 'manutencao':
            foreach (MaintenanceService::cleanup() as $label => $count) {
                out(sprintf('  %s: %d removido(s)', str_replace('_', ' ', $label), $count));
            }
            break;

        case 'diario':
            out('[' . date('Y-m-d H:i') . '] Rotina diária do ÍSIS');
            backup(true);
            $stats = ReminderService::run();
            out(sprintf('Lembretes: %d enviado(s).', $stats['sent']));
            out(sprintf('Avisos de assinatura: %d enviado(s).', Isis\Services\SubscriptionService::sendNotices()));
            $clean = MaintenanceService::cleanup();
            out('Manutenção: ' . array_sum($clean) . ' registro(s) temporário(s) removido(s).');
            break;

        case 'assinaturas':
            out(sprintf('Avisos de assinatura: %d e-mail(s) enviado(s).', Isis\Services\SubscriptionService::sendNotices()));
            foreach ((new Isis\Repositories\SubscriptionRepository())->allSubscriptions() as $sub) {
                $state = Isis\Services\SubscriptionService::state($sub);
                out(sprintf('  empresa %d · %s · %s até %s', $sub['tenant_id'], $sub['plan_name'], $state['label'], $state['ends_at'] ?? '-'));
            }
            break;

        case 'plataforma:admin':
            $email = mb_strtolower(trim($positional[0] ?? ''));
            $name = trim($positional[1] ?? '');
            if (!filter_var($email, FILTER_VALIDATE_EMAIL) || mb_strlen($name) < 3) {
                throw new RuntimeException('Uso: php bin/isis plataforma:admin <email> "<Nome completo>"');
            }
            fwrite(STDOUT, 'Senha (mínimo 12 caracteres; deixe vazio para gerar uma): ');
            $password = trim((string) preg_replace('/^\xEF\xBB\xBF/', '', (string) fgets(STDIN))); // ignora BOM de terminais Windows
            $generated = $password === '';
            if ($generated) {
                $password = rtrim(strtr(base64_encode(random_bytes(15)), '+/', 'Kx'), '=');
            }
            if (mb_strlen($password) < 12) {
                throw new RuntimeException('A senha precisa ter pelo menos 12 caracteres.');
            }
            $id = (new Isis\Repositories\PlatformRepository())->saveAdmin($name, $email, Isis\Auth\Auth::hashPassword($password));
            out("Administrador da plataforma #{$id} salvo: {$email}. Entre em /plataforma/entrar.");
            if ($generated) {
                out("Senha gerada (aparece só agora; troque depois em Configurações da plataforma): {$password}");
            }
            break;

        case 'email:teste':
            $to = $positional[0] ?? '';
            if (!filter_var($to, FILTER_VALIDATE_EMAIL)) {
                throw new RuntimeException('Uso: php bin/isis email:teste <destino@exemplo.com>');
            }
            $driver = (string) Config::get('mail.driver');
            out(sprintf('Driver: %s · servidor: %s:%s (%s) · usuário: %s · remetente: %s <%s>',
                $driver, Config::get('mail.host') ?: '-', Config::get('mail.port'), Config::get('mail.encryption') ?: 'sem criptografia',
                Config::get('mail.username') ?: '-', Config::get('mail.from_name'), Config::get('mail.from_address')));
            if ($driver === 'smtp' && !class_exists(\PHPMailer\PHPMailer\PHPMailer::class)) {
                throw new RuntimeException('PHPMailer não encontrado. Rode "composer install --no-dev" no servidor ou envie a pasta vendor/.');
            }
            $ok = Isis\Core\Mailer::send($to, 'Teste de e-mail do ÍSIS',
                '<p>Este é um e-mail de teste do <strong>ÍSIS</strong>, enviado em ' . date('d/m/Y H:i') . '.</p><p>Se você recebeu, o envio está funcionando.</p>');
            if ($driver === 'log') {
                out('MAIL_DRIVER=log: a mensagem foi gravada em storage/logs/mail.log (nada foi enviado). Para enviar de verdade, use MAIL_DRIVER=smtp.');
            } elseif ($ok) {
                out("Enviado para {$to}. Confira a caixa de entrada e o spam.");
            } else {
                out('Falha no envio. O motivo está em storage/logs/app-' . date('Y-m-d') . '.log (linha "Falha no envio de e-mail").');
                exit(4);
            }
            break;

        case 'verificar':
            $failures = 0;
            foreach (MaintenanceService::check() as $check) {
                out(sprintf('[%s] %s · %s', $check['ok'] ? 'ok' : '!!', $check['label'], $check['detail']));
                $failures += $check['ok'] ? 0 : 1;
            }
            out($failures === 0 ? 'Tudo certo.' : "{$failures} ponto(s) de atenção.");
            exit($failures === 0 ? 0 : 3);

        case 'audit:verify':
            $keys = array_column(Database::fetchAll('SELECT chain_key FROM audit_chain ORDER BY chain_key'), 'chain_key');
            $failures = 0;
            foreach ($keys as $key) {
                $key = (int) $key;
                $stmt = Database::pdo()->prepare($key === 0
                    ? 'SELECT * FROM audit_logs WHERE tenant_id IS NULL ORDER BY id'
                    : 'SELECT * FROM audit_logs WHERE tenant_id = ? ORDER BY id');
                $stmt->execute($key === 0 ? [] : [$key]);
                $result = AuditHasher::verify($stmt->fetchAll());
                out(sprintf('Cadeia %s: %s (%d registros)%s', $key === 0 ? 'global' : "empresa {$key}", $result['ok'] ? 'íntegra' : 'VIOLADA', $result['checked'], $result['broken_id'] ? " - quebra no registro {$result['broken_id']}" : ''));
                $failures += $result['ok'] ? 0 : 1;
            }
            exit($failures > 0 ? 2 : 0);

        default:
            out('Comandos: key:generate | migrate | install [--demo] | seed:demo | diario | backup | backup:listar | backup:decifrar | backup:restaurar | lembretes | manutencao | verificar | email:teste | assinaturas | plataforma:admin | audit:verify');
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Erro: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
