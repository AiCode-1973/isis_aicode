# ÍSIS - configuração do ambiente
# Copie para .env e ajuste. Nunca versione o arquivo .env.

APP_NAME=ÍSIS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://isis.aicode.dev.br
APP_TIMEZONE=America/Sao_Paulo

# Chave mestra de criptografia (32 bytes em base64). Gere com: php bin/isis key:generate
# ATENÇÃO: se perder ou trocar esta chave, os dados criptografados ficam ilegíveis. Guarde uma cópia segura.
APP_KEY=

# Atrás de proxy/CDN (ex.: Cloudflare) confiável? Então true para ler o IP real do X-Forwarded-For.
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isis
DB_USERNAME=isis
DB_PASSWORD=

# Sessão (minutos)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
# true em produção (HTTPS). Em desenvolvimento local sem HTTPS use false.
SESSION_SECURE_COOKIE=true

# E-mail: log (só grava em storage/logs/mail.log) ou smtp (envia de verdade; requer o PHPMailer do composer).
# Passo a passo e problemas comuns: README, seção "E-mail (SMTP)". Teste com: php bin/isis email:teste voce@exemplo.com
# Porta 465 + ssl  OU  porta 587 + tls. Usuário = e-mail completo. Remetente = o mesmo e-mail autenticado.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@aicode.dev.br
MAIL_FROM_NAME="ÍSIS"

# Instalador web (/instalar). Defina um valor longo e aleatório só durante a instalação e apague depois.
INSTALL_TOKEN=

# Backups (php bin/isis backup): quantos diários manter e, além deles, quantos semanais
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Planos e cobrança manual: dias de teste grátis, plano do teste e tolerância após o vencimento
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=profissional
BILLING_GRACE_DAYS=7
